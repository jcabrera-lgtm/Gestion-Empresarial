                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set(\"ventaId\", data._id);",
                  "pm.test(\"Estado inicial pendiente\", () => pm.expect(data.estado).to.eql(\"pendiente\"));",
                  "pm.test(\"Total = subtotal + IVA\", () => pm.expect(data.total).to.be.closeTo(data.subtotal + data.iva, 0.01));"
