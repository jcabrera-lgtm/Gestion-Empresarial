# --- Etapa 1: compilar la app ---
FROM node:22 AS build
WORKDIR /home/app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# --- Etapa 2: servir los archivos estáticos ---
FROM nginx:alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /home/app/dist /usr/share/nginx/html
EXPOSE 80
